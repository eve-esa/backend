PORT=8000 # for docker
WORKERS=2 # for docker

# QDRANT Configuration
QDRANT_URL=
QDRANT_API_KEY=

# LLM Model URLs (OpenAI-compatible format)
MAIN_MODEL_URL=https://api.runpod.ai/v2/{main_endpoint_id}/openai/v1
FALLBACK_MODEL_URL=https://api.mistral.ai/v1
# Optional: Override model names (defaults from config.yaml)
MAIN_MODEL_NAME=eve-esa/eve_v0.1
FALLBACK_MODEL_NAME=mistral-small-latest
# LLM Model API KEYS
MAIN_MODEL_API_KEY=
FALLBACK_MODEL_API_KEY=

MODEL_TIMEOUT=13

# Ordered endpoint chain walked when a request names no model. Unconfigured
# entries are dropped and the fallback model is always the last resort.
EVE_ENDPOINT_ORDER=eve_jsc,main,fallback
# How long a failing endpoint stays skipped before the next request probes it.
EVE_ENDPOINT_COOLDOWN_S=120
# First-token budgets, per endpoint: RunPod is serverless and cold-starts for
# minutes, JSC is a warm vLLM, so one MODEL_TIMEOUT cannot serve both.
# EVE_JSC_TIMEOUT defaults to MODEL_TIMEOUT, MAIN_MODEL_TIMEOUT to 120.
EVE_JSC_TIMEOUT=13
MAIN_MODEL_TIMEOUT=120

EMBEDDING_URL=https://api.deepinfra.com/v1/openai
EMBEDDING_API_KEY=

EMBEDDING_FALLBACK_URL=https://api.inference.net/v1
EMBEDDING_FALLBACK_API_KEY=

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=root
MONGO_PASSWORD=
MONGO_DATABASE=eve-backend
MONGO_PARAMS=

# JWT Configuration
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@eve-esa.com
EMAIL_FROM_NAME=EVE

# CORS (comma separated list)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# S3 / Artifact storage
# Leave S3_ENDPOINT_URL empty to use real AWS S3; set to http://minio:9000 for local MinIO.
S3_BUCKET_NAME=eve-x-artifacts-local
S3_REGION=eu-central-1
S3_ENDPOINT_URL=http://minio:9000
# Dedicated credentials (do not collide with the AWS_* vars used by the CLI).
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PRESIGN_TTL_SECONDS=300
# Legacy user-upload path knobs (POST /artifacts with an image file). Still
# read as fallback defaults for the ARTIFACT_UPLOAD_* knobs below; leave unset
# on new hosts.
IMAGE_MAX_BYTES=10485760
IMAGE_ALLOWED_TYPES=png,jpeg,webp,gif
IMAGE_UPLOADS_PER_DAY=100
# Generic artifact knobs, consumed by MCP tool-output ingestion.
ARTIFACT_MAX_BYTES=26214400
ARTIFACT_MAX_PER_TOOL_CALL=10
ARTIFACT_RESOURCE_READ_TIMEOUT_S=30
# Generalized user-upload path knobs (POST /artifacts with any allowed file
# type: images, pdf, csv, txt, json, geojson).
ARTIFACT_UPLOAD_ALLOWED_TYPES=png,jpeg,webp,gif,pdf,csv,txt,json,geojson
ARTIFACT_UPLOAD_MAX_BYTES=10485760
ARTIFACT_UPLOADS_PER_DAY=100

# Curated image catalog (demo). Set to false/0 to disable (prompts stay
# byte-identical to the catalog-free behaviour). IMAGE_CATALOG_PATH defaults to
# the shipped src/templates/image_catalog.yaml.
FEATURE_IMAGE_CATALOG=true
IMAGE_CATALOG_PATH=

DEEPINFRA_API_TOKEN=
SILICONFLOW_API_TOKEN=

SCRAPING_DOG_API_KEY=

SATCOM_SMALL_MODEL_NAME=esa-sceva/satcom-chat-8b
SATCOM_LARGE_MODEL_NAME=esa-sceva/satcom-chat-70b
SATCOM_MODEL_API_KEY=
SATCOM_LARGE_MODEL_URL=https://api.runpod.ai/v2/{satcom_large_endpoint_id}/openai/v1
SATCOM_SMALL_MODEL_URL=https://api.runpod.ai/v2/{satcom_small_endpoint_id}/openai/v1

EVE_JSC_BASE_URL=
EVE_JSC_MODEL_NAME=alias-eve
EVE_JSC_API_KEY=
# On: /models lists the JSC model first and the frontend defaults to it.
# Needs EVE_JSC_BASE_URL; a blank base URL wins over the flag.
FEATURE_JSC_MODEL=

SATCOM_QDRANT_URL=
SATCOM_QDRANT_API_KEY=

REDIS_URL=redis://127.0.0.1:6379/0

# Which environment this is: dev, staging or prod. Infra sets it from Terraform's
# var.environment; IS_PROD is derived from it. Anything else reads as non-production.
APP_ENVIRONMENT=dev

FEATURE_TOKEN_RATE_LIMIT=true
TOKEN_RATE_LIMIT_DEFAULT_GROUP=eve_free
FREE_TOKENS=
FREE_PERIOD_MONTHS=
PRO_TOKENS=
PRO_PERIOD_MONTHS=
PRO_PLUS_TOKENS=
PRO_PLUS_PERIOD_MONTHS=
ULTRA_TOKENS=
ULTRA_PERIOD_MONTHS=

# OpenAI-compatible proxy — upstream base URL (e.g. "https://example.com") and optional API key
OPENAI_PROXY_UPSTREAM_URL=https://api.runpod.ai/v2/{main_endpoint_id}/openai/v1 # same as MAIN_MODEL_URL
OPENAI_PROXY_API_KEY=                                                           # same as MAIN_MODEL_API_KEY

# User custom model API keys (BYOM) - envelope-encrypted on the row (AES-256-GCM)
AWS_REGION=eu-central-1
# Optional: LocalStack or other AWS-compatible endpoint for local dev
# AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Legacy: only matters for un-migrated rows that still carry a Secrets Manager
# secret_arn (see src/commands/migrate_custom_model_secrets.py).
CUSTOM_MODEL_SECRET_PREFIX=eve/dev
CUSTOM_MODEL_MAX_PER_USER=10
# DEK-wrapping backend for the envelope cipher. Set exactly one:
#   CUSTOM_MODEL_KMS_KEY_ID - a KMS CMK id/ARN/alias (cloud). Wins if both are set.
#   BYOK_LOCAL_KEK - a static 256-bit key, base64 or hex (local/CI, no AWS needed).
# Generate a local dev value with:
#   python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
CUSTOM_MODEL_KMS_KEY_ID=
BYOK_LOCAL_KEK=REPLACE_WITH_A_LOCALLY_GENERATED_BASE64_32_BYTE_KEY

# Feature flags. A flag names the feature, never the environment it runs in.
# Off (the default) means self-signup is not published: POST /signup answers 404.
FEATURE_SELF_SIGNUP=
